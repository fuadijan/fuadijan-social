{
  "name": "fuadijan-social",
  "version": "0.1.0",
  "private": true,
  "description": "Fuadijan Social Agent: reminders, photo intake over Telegram, branded post packs for a 30-day Instagram calendar.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "migrate": "tsx src/db/migrate.ts --create",
    "seed-calendar": "tsx calendar/seed.ts",
    "dry-run": "tsx src/dry-run.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@panva/hkdf": "^1.2.1",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "heic-convert": "^2.1.0",
    "jose": "^6.2.14",
    "jszip": "^3.10.2",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.14.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "next-auth": "^4.24.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
