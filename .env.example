# Copy to .env. Everything runs on Sydney time; timestamps are stored as UTC.

# core
TZ=Australia/Sydney
PORT=3000
# Local: the user-owned Postgres 16 started by `npm run db:local` (port 5433), or the
# postgresql-x64-16 Windows service on 5432 (postgres://postgres:postgres@localhost:5432/fuadijan_social).
DATABASE_URL=postgres://postgres@localhost:5433/fuadijan_social
# Database tests run only when this is set and the name ends in _test (it is wiped first).
TEST_DATABASE_URL=postgres://postgres@localhost:5433/fuadijan_social_test
DATA_DIR=./data
CALENDAR_START=2026-11-03
WEB_URL=http://localhost:3000
# Bearer token for POST /run/<job> (fire a reminder or the worker by hand). Leave blank to disable.
RUN_TOKEN=

# hub login. With HUB_COOKIE_DOMAIN unset the app trusts DEV_USER (local development only).
HUB_URL=https://apps.nutrimeals.au
HUB_COOKIE_DOMAIN=
NEXTAUTH_SECRET=
HUB_SESSION_MAX_HOURS=48
DEV_USER=Ahmad

# Telegram (BotFather token; the chat id shows up in the log the first time you message the bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Set to 1 to answer every Claude call from test/fixtures/claude (no key needed; the dry run does this itself).
CLAUDE_FIXTURES=

# menu facts: menu-screens (default) | pos | file
MENU_SOURCE=menu-screens
MENU_SCREENS_URL=https://fjtv.nutrimeals.au/api/menu
MENU_FILE=./data/menu.json
POS_DATABASE_URL=

# reminders (Sydney, HH:MM)
BRIEF_TIME=08:30
STORY_TIME=12:00
NUDGE_TIME=21:30
REVIEW_TIME=17:00

# photo quality thresholds
MIN_LONG_EDGE=1600
MIN_LUMINANCE=45
MIN_LAPLACIAN=60

# Cut 2. Background removal: u2netp (default, local Apache-2.0 model, 4.7 MB download on first use) | isnet (176 MB, sharper) | removebg | none
BACKGROUND_REMOVER=u2netp
REMOVE_BG_KEY=
MESSENGER=telegram
SMTP2GO_API_KEY=
EMAIL_FROM="Fuadijan Social <social@nutrimeals.au>"
EMAIL_TO=
